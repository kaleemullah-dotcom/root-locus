{
  "name": "root-locus-studio",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Root Locus Studio — general-purpose root locus solver using the 7-rule (R1–R7) method",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "vitest run && npm run verify",
    "test:unit": "vitest run",
    "test:watch": "vitest",
    "dump": "tsx scripts/dump-cases.ts",
    "verify": "tsx scripts/dump-cases.ts && python scripts/verify.py",
    "screenshots": "tsx scripts/screenshots.ts",
    "lighthouse": "tsx scripts/lighthouse.ts",
    "e2e": "tsx scripts/e2e.ts"
  },
  "dependencies": {
    "jspdf": "^4.2.1",
    "katex": "^0.19.1",
    "modern-screenshot": "^4.7.0",
    "motion": "^14.14.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@fontsource/inter": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@playwright/test": "^1.65.1",
    "@types/katex": "^0.16.8",
    "@types/node": "^26.6.6",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.7.0",
    "autoprefixer": "^10.7.0",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^17.14.0",
    "postcss": "^8.5.33",
    "prettier": "^3.10.1",
    "tailwindcss": "^3.4.19",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.73.0",
    "vite": "^6.4.6",
    "vitest": "^3.2.7"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT"
}
